+  const monitorSignal = AbortSignal.any([signal, controller.signal]);
+  const identities = new Map();
+  let baseline;
+  let sequence = 0;
+  let pending;
+  let previous = new Set();
+  let missedSlots = 0;
+  let failure;
+  let stopping = false;
+  let underlyingReadPending = false;
