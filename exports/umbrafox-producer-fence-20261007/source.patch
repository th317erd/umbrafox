+  }
+  if (
+    soak &&
+    (await bounded(
+      server.nextCheckpoint(),
+      "Lifecycle terminal checkpoint",
+      15000
+    )) !== null
+  ) {
+    throw new Error("Unexpected lifecycle terminal checkpoint");
+  }
+}
