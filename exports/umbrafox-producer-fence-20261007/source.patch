+  wait = (ms, activeSignal) => delay(ms, undefined, { signal: activeSignal }),
+}) {
+  trustedPlan(plan);
+  const soak = plan.name === "soak-30m";
+  for (const expected of plan.checkpoints) {
+    const { id } = expected;
+    signal.throwIfAborted();
+    if (soak) {
+      budget.admit(id);
+    }
