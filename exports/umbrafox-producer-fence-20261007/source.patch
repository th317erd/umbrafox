+function captureInput(scenario = "valid", plan = null) {
+  const checkpoints =
+    plan?.checkpoints ??
+    [2, 7, 12].map((completedCycles, id) => ({
+      id,
+      settleMs: 10000,
+      completedCycles,
+      documentsCompleted: [8, 24, 40][id],
+    }));
+  const documentIDs = checkpoints.map(item => item.documentsCompleted - 1);
+  let clock = 0;
+  let nextID = 0;
+  let held = false;
+  let heldAt;
+  let active = 0;
+  const events = [];
+  const controller = new AbortController();
+  const input = {
+    ...(plan ? { plan } : {}),
+    signal: controller.signal,
+    now: () => clock,
+    async wait(milliseconds, signal) {
+      assert(held);
+      assert.equal(signal, controller.signal);
+      signal.throwIfAborted();
+      events.push("quiet");
+      clock += milliseconds;
+      if (scenario === "abort") {
+        controller.abort(new Error("HALT"));
+      }
+    },
+    bounded: promise => promise,
+    owned: { child: { pid: 101 } },
+    profile: "/profile",
+    admission: {
+      urls: [0, ...documentIDs].map(documentURL),
+      context: tabContext,
+    },
+    server: {
+      async nextCheckpoint() {
+        assert(!held);
+        if (nextID === checkpoints.length) {
+          return null;
+        }
+        held = true;
+        heldAt = clock;
+        const id = nextID++;
+        return {
+          ...checkpoints[id],
+          id: scenario === "order" ? 2 : id,
+        };
+      },
+      releaseCheckpoint(id) {
+        assert(held);
+        assert(clock - heldAt >= 10000);
+        events.push(`release:${id}`);
+        held = false;
+      },
+    },
+    monitor: {
+      async sampleNow() {
+        return resources();
+      },
+      async setBaseline() {
+        assert(clock - heldAt >= 10000);
+        events.push("baseline");
+        return resources();
+      },
+    },
+    control: {
+      async request(method, params) {
+        assert(held);
