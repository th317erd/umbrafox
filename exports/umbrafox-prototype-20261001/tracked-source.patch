+            let (pass, target, draw) = (trace.pass, trace.target, trace.draws);
+            Self::sampling_marker(trace, "quad-draw", format_args!(
+                "\"id\":{},\"pass\":{},\"target\":{},\"draw\":{},\"pattern\":\"{:?}\",\"blend\":\"{:?}\",\"framebuffer_scissor\":{},\"projection_bits\":{:?}",
