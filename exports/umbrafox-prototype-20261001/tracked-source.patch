+                "\"id\":{},\"words\":{:?},\"binding\":\"{}\",\"sources\":[\"{:?}\",\"{:?}\",\"{:?}\"],\"header\":{:?},\"bits\":{:?},\"transform_id\":{},\"transform_bits\":{:?}",
