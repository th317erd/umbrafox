+          const removeOldHandler = first.addEventListener(
+            "request",
+            oldHandler
+          );
+          dispatchUmbrafoxUserlandRequest(current, {
+            browsingContextId,
+            innerWindowId: firstID,
+          });
+          dispatchUmbrafoxUserlandRequest(current, {
+            browsingContextId,
+            innerWindowId: secondID,
