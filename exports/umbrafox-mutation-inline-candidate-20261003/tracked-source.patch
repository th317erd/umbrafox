+      !aTransform.IsIdentity() || aSamplingFilter != SamplingFilter::LINEAR ||
+      aSourceRect.x != 0.0 || aSourceRect.y != 0.0 ||
+      aSourceRect.width != aImageSize.width ||
+      aSourceRect.height != aImageSize.height) {
+    return nullptr;
+  }
+
+  const IntSize readbackSize = IntSize::Ceil(aDestRect.width, aDestRect.height);
+  if (readbackSize.IsEmpty() || readbackSize.width != aDestRect.width ||
+      readbackSize.height != aDestRect.height ||
+      (readbackSize.width >= aImageSize.width &&
+       readbackSize.height >= aImageSize.height)) {
+    return nullptr;
+  }
+
+  RefPtr<SourceSurface> surface = gpuVideo->GetAsSourceSurface(readbackSize);
+  if (!surface || surface->GetSize() != readbackSize) {
+    return nullptr;
+  }
+  return surface.forget();
+}
