+      await writeFile(join(directory, "libxul.so"), "synthetic");
+      const bytes =
+        scenario === "oversize"
+          ? Buffer.alloc(65537)
+          : Buffer.from([91, 65, 112, 112, 93, 13, 10, 255]);
+      await writeFile(join(directory, "application.ini"), bytes);
