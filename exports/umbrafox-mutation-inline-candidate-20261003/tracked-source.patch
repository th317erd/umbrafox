+            if (scenario === "baseline-cap") {
+              value.totals.rssBytes = 3 * GiB;
+            }
+          }
+          return value;
+        },
+        async save(fileName) {
+          if (
+            (scenario === "save" && reads > 1) ||
+            (scenario === "baseline-save" &&
+              fileName === "lifecycle-baseline.json")
+          ) {
+            throw original;
+          }
+        },
+        wait(ms, signal) {
+          return new Promise((resolve, reject) =>
