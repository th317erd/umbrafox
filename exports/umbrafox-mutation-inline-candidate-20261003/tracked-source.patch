+      let reads = 0;
+      const monitor = await startLifecycleMonitor({
+        owned: {},
+        root: "/output",
+        signal: controller.signal,
+        abort: reason => reasons.push(reason),
+        async sample() {
+          const value = resources();
+          if (++reads > 1) {
+            if (scenario === "read") {
+              throw original;
+            }
+            if (scenario === "cap") {
+              value.totals.rssBytes = 5 * GiB;
