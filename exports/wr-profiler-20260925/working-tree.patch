+static layers::GPUVideoImage* GetDMABufGPUVideoImage(layers::Image* aImage) {
+  layers::GPUVideoImage* gpuVideo =
+      aImage ? aImage->AsGPUVideoImage() : nullptr;
+  if (!gpuVideo || gpuVideo->GetRemoteDecoderVideoType() !=
+                       layers::RemoteDecoderVideoType::DMABuf) {
+    return nullptr;
+  }
+  return gpuVideo;
+}
+
+static already_AddRefed<SourceSurface>
+MaybeGetScaledSourceSurfaceForRemoteVideo(layers::Image* aImage,
+                                          const gfx::Rect& aSourceRect,
+                                          const gfx::Rect& aDestRect,
+                                          const gfx::IntSize& aImageSize,
+                                          const Matrix& aTransform,
+                                          SamplingFilter aSamplingFilter,
+                                          VideoRotation aRotationDeg) {
+  layers::GPUVideoImage* gpuVideo = GetDMABufGPUVideoImage(aImage);
+  if (!gpuVideo || aRotationDeg != VideoRotation::kDegree_0 ||
+      !aTransform.IsIdentity() || aSamplingFilter != SamplingFilter::LINEAR ||
+      aSourceRect.x != 0.0 || aSourceRect.y != 0.0 ||
+      aSourceRect.width != aImageSize.width ||
+      aSourceRect.height != aImageSize.height) {
+    return nullptr;
+  }
+
+  const IntSize readbackSize = IntSize::Ceil(aDestRect.width, aDestRect.height);
+  if (readbackSize.IsEmpty() || readbackSize.width != aDestRect.width ||
+      readbackSize.height != aDestRect.height ||
+      (readbackSize.width >= aImageSize.width &&
+       readbackSize.height >= aImageSize.height)) {
+    return nullptr;
+  }
+
+  RefPtr<SourceSurface> surface = gpuVideo->GetAsSourceSurface(readbackSize);
+  if (!surface || surface->GetSize() != readbackSize) {
+    return nullptr;
+  }
+  return surface.forget();
+}
