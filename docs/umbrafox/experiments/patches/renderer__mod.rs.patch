+    #[cfg(feature = "umbra-perf-probes")]
+    fn sampling_target(&mut self, texture: TextureSource, clear: Option<ColorF>, render_area: Option<DeviceIntRect>, draw_target: DrawTarget) {
+        if !self.sampling_active() { return; }
